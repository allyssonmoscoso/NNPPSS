<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="settings-panel" spacing="0.0"
      xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.squarepeace.nnppss.fx.controllers.ConfigController"
      prefWidth="640.0" prefHeight="720.0">

    <VBox styleClass="settings-header" spacing="4.0">
        <HBox alignment="CENTER_LEFT" spacing="8.0">
            <Label fx:id="titleLabel" text="%config.title" styleClass="settings-title"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="stepLabel" text="%config.step" styleClass="step-label"
                   visible="false" managed="false"/>
        </HBox>
        <Label fx:id="subtitleLabel" text="%config.subtitle" styleClass="settings-subtitle" wrapText="true"/>
    </VBox>

    <ScrollPane fitToWidth="true" styleClass="settings-scroll" VBox.vgrow="ALWAYS">
        <VBox styleClass="settings-content" spacing="16.0">
            <VBox fx:id="librariesSection" styleClass="settings-section" spacing="10.0">
                <Label text="%config.section.libraries" styleClass="section-title"/>
                <Label text="%config.section.libraries.hint" styleClass="field-hint" wrapText="true"/>

                <GridPane hgap="12.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140.0" prefWidth="155.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>
                    <rowConstraints>
                        <RowConstraints minHeight="10.0"/>
                        <RowConstraints minHeight="10.0"/>
                        <RowConstraints minHeight="10.0"/>
                    </rowConstraints>

                    <Label text="%config.label.psvitaurl" styleClass="field-label" GridPane.rowIndex="0"/>
                    <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <TextField fx:id="txtPsvitaUrl" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnTestPsvita" text="%button.test" styleClass="subtle-button"
                                onAction="#handleTestPsvita"/>
                        <Label fx:id="testPsvitaLabel" styleClass="test-status" minWidth="58.0"/>
                    </HBox>

                    <Label text="%config.label.pspurl" styleClass="field-label" GridPane.rowIndex="1"/>
                    <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <TextField fx:id="txtPspUrl" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnTestPsp" text="%button.test" styleClass="subtle-button"
                                onAction="#handleTestPsp"/>
                        <Label fx:id="testPspLabel" styleClass="test-status" minWidth="58.0"/>
                    </HBox>

                    <Label text="%config.label.psxurl" styleClass="field-label" GridPane.rowIndex="2"/>
                    <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="2">
                        <TextField fx:id="txtPsxUrl" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnTestPsx" text="%button.test" styleClass="subtle-button"
                                onAction="#handleTestPsx"/>
                        <Label fx:id="testPsxLabel" styleClass="test-status" minWidth="58.0"/>
                    </HBox>
                </GridPane>
            </VBox>

            <VBox fx:id="storageSection" styleClass="settings-section" spacing="10.0">
                <Label text="%config.section.storage" styleClass="section-title"/>
                <Label text="%config.section.storage.hint" styleClass="field-hint" wrapText="true"/>

                <GridPane hgap="12.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140.0" prefWidth="155.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="%config.label.downloadsdir" styleClass="field-label" GridPane.rowIndex="0"/>
                    <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <TextField fx:id="txtDownloadsDir" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnChooseDownloads" text="%button.choose" styleClass="subtle-button"
                                onAction="#handleChooseDownloads"/>
                        <Button fx:id="btnOpenDownloads" text="%button.open" styleClass="subtle-button"
                                onAction="#handleOpenDownloads"/>
                    </HBox>

                    <Label text="%config.label.extractiondir" styleClass="field-label" GridPane.rowIndex="1"/>
                    <HBox spacing="6.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <TextField fx:id="txtExtractionDir" HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnChooseExtraction" text="%button.choose" styleClass="subtle-button"
                                onAction="#handleChooseExtraction"/>
                        <Button fx:id="btnOpenExtraction" text="%button.open" styleClass="subtle-button"
                                onAction="#handleOpenExtraction"/>
                    </HBox>
                </GridPane>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="storageHint" styleClass="field-hint" wrapText="true" HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnResetStorage" text="%button.reset" styleClass="subtle-button"
                            onAction="#handleResetStorage"/>
                </HBox>

                <VBox styleClass="settings-subsection" spacing="6.0">
                    <Label text="%config.section.pkg2zip" styleClass="section-title"/>
                    <HBox alignment="CENTER_LEFT" spacing="8.0">
                        <Label fx:id="pkg2zipStatusLabel" styleClass="pkg2zip-status"/>
                        <Region HBox.hgrow="ALWAYS"/>
                        <Button fx:id="btnDetectPkg2zip" text="%config.pkg2zip.detect"
                                styleClass="subtle-button" onAction="#handleDetectPkg2zip"/>
                        <Button fx:id="btnChoosePkg2zip" text="%config.pkg2zip.choose"
                                styleClass="subtle-button" onAction="#handleChoosePkg2zip"/>
                    </HBox>
                    <Label fx:id="pkg2zipPathLabel" styleClass="pkg2zip-path" wrapText="true"/>
                    <Label text="%config.pkg2zip.hint" styleClass="field-hint" wrapText="true"/>
                </VBox>
            </VBox>

            <VBox fx:id="downloadsSection" styleClass="settings-section" spacing="10.0">
                <Label text="%config.section.downloads" styleClass="section-title"/>

                <GridPane hgap="12.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140.0" prefWidth="155.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="%config.label.simultaneous" styleClass="field-label" GridPane.rowIndex="0"/>
                    <Spinner fx:id="spinnerSimultaneous" maxWidth="140.0"
                             GridPane.columnIndex="1" GridPane.rowIndex="0"/>

                    <Label text="%config.label.speedlimit" styleClass="field-label" GridPane.rowIndex="1"/>
                    <HBox spacing="8.0" alignment="CENTER_LEFT" GridPane.columnIndex="1" GridPane.rowIndex="1">
                        <Spinner fx:id="spinnerSpeedLimit" maxWidth="160.0"/>
                        <Label text="%config.tooltip.speedlimit" styleClass="field-hint"/>
                    </HBox>

                    <Label text="%config.label.options" styleClass="field-label" GridPane.rowIndex="2"/>
                    <CheckBox fx:id="checkAutoCleanup" text="%config.label.autocleanup"
                              GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                </GridPane>
            </VBox>

            <VBox fx:id="appearanceSection" styleClass="settings-section" spacing="10.0">
                <Label text="%config.section.appearance" styleClass="section-title"/>

                <GridPane hgap="12.0" vgap="10.0">
                    <columnConstraints>
                        <ColumnConstraints minWidth="140.0" prefWidth="155.0"/>
                        <ColumnConstraints hgrow="ALWAYS"/>
                    </columnConstraints>

                    <Label text="%config.label.language" styleClass="field-label" GridPane.rowIndex="0"/>
                    <VBox spacing="3.0" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <ComboBox fx:id="comboLanguage" prefWidth="180.0"/>
                        <Label text="%config.language.message" styleClass="field-hint" wrapText="true"/>
                    </VBox>

                    <Label text="%config.label.theme" styleClass="field-label" GridPane.rowIndex="1"/>
                    <CheckBox fx:id="checkDarkMode" text="%config.label.darkmode"
                              GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                </GridPane>
            </VBox>

            <Label fx:id="validationLabel" styleClass="validation-error" wrapText="true"
                   visible="false" managed="false"/>

            <Region prefHeight="4.0"/>
        </VBox>
    </ScrollPane>

    <HBox styleClass="settings-footer" spacing="8.0" alignment="CENTER_RIGHT">
        <Button fx:id="btnClear" text="%button.clear" styleClass="subtle-button" onAction="#handleClear"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="btnBack" text="%button.back" styleClass="subtle-button"
                visible="false" managed="false" onAction="#handleBack"/>
        <Button fx:id="btnNext" text="%button.next" styleClass="primary-button"
                visible="false" managed="false" onAction="#handleNext"/>
        <Button fx:id="btnClose" text="%button.close" styleClass="subtle-button" cancelButton="true" onAction="#handleClose"/>
        <Button fx:id="btnSave" text="%button.save" styleClass="primary-button" defaultButton="true" onAction="#handleSave"/>
    </HBox>

</VBox>
