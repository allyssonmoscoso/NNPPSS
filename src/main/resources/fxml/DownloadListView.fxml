<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.squarepeace.nnppss.fx.controllers.DownloadListController"
            prefHeight="460.0" prefWidth="820.0">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="%dialog.downloadqueue.title">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableQueue">
            <columns>
                <TableColumn fx:id="colIndex" text="#" prefWidth="40.0" sortable="false"/>
                <TableColumn fx:id="colTitle" text="%table.column.name" prefWidth="320.0"/>
                <TableColumn fx:id="colRegion" text="%table.column.region" prefWidth="70.0"/>
                <TableColumn fx:id="colConsole" text="%table.column.console" prefWidth="90.0"/>
                <TableColumn fx:id="colSize" text="%table.column.size" prefWidth="100.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="%dialog.downloadlist.empty"/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <VBox spacing="6.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>

            <Label fx:id="statsLabel" text="%label.queueempty"/>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button fx:id="btnSelectAll" text="%button.selectall" onAction="#handleSelectAll"/>
                <Button fx:id="btnDeselectAll" text="%button.deselectall" onAction="#handleDeselectAll"/>
                <Button fx:id="btnMoveUp" text="%button.moveup" onAction="#handleMoveUp"/>
                <Button fx:id="btnMoveDown" text="%button.movedown" onAction="#handleMoveDown"/>
                <Button fx:id="btnRemove" text="%button.removeselected" onAction="#handleRemoveSelected"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8.0">
                <Button fx:id="btnClear" text="%button.clearall" onAction="#handleClearAll"/>
                <Button fx:id="btnExport" text="%button.export" onAction="#handleExport"/>
                <Button fx:id="btnImport" text="%button.import" onAction="#handleImport"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button fx:id="btnStart" text="%button.startdownloads" defaultButton="true"
                        onAction="#handleStartDownloads"/>
                <Button fx:id="btnClose" text="%button.close" cancelButton="true" onAction="#handleClose"/>
            </HBox>
        </VBox>
    </bottom>

</BorderPane>
