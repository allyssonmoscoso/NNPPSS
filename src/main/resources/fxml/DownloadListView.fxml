<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.text.Font?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.squarepeace.nnppss.fx.controllers.DownloadListController"
            prefHeight="400.0" prefWidth="600.0">

    <top>
        <HBox alignment="CENTER_LEFT" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            <Label text="Download Queue">
                <font>
                    <Font name="System Bold" size="14.0"/>
                </font>
            </Label>
        </HBox>
    </top>

    <center>
        <TableView fx:id="tableQueue">
            <columns>
                <TableColumn fx:id="colTitle" text="Title" prefWidth="250.0"/>
                <TableColumn fx:id="colRegion" text="Region" prefWidth="60.0"/>
                <TableColumn fx:id="colConsole" text="Console" prefWidth="80.0"/>
                <TableColumn fx:id="colSize" text="Size" prefWidth="80.0"/>
            </columns>
            <columnResizePolicy>
                <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
            </columnResizePolicy>
            <placeholder>
                <Label text="Queue is empty. Add games from the main list."/>
            </placeholder>
        </TableView>
    </center>

    <bottom>
        <HBox alignment="CENTER_RIGHT" spacing="10.0">
            <padding>
                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0"/>
            </padding>
            
            <Button fx:id="btnRemove" text="Remove Selected" onAction="#handleRemoveSelected"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button fx:id="btnStart" text="Start Downloads" onAction="#handleStartDownloads" defaultButton="true"/>
            <Button fx:id="btnClose" text="Close" onAction="#handleClose"/>
        </HBox>
    </bottom>

</BorderPane>
