<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="rootStack"
           styleClass="app-root"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.squarepeace.nnppss.fx.controllers.MainController"
           prefHeight="760.0" prefWidth="1180.0">

    <BorderPane fx:id="mainContainer">
        <top>
            <VBox spacing="0.0">
                <!-- App bar: brand, console switch, search, global actions -->
                <HBox styleClass="app-bar" alignment="CENTER_LEFT" spacing="12.0">
                    <Label text="NNPPSS" styleClass="brand" />
                    <HBox fx:id="consoleBox" styleClass="console-switch" spacing="2.0">
                        <RadioButton fx:id="rbVita" text="%console.psvita" styleClass="console-toggle" selected="true"/>
                        <RadioButton fx:id="rbPsp" text="%console.psp" styleClass="console-toggle"/>
                        <RadioButton fx:id="rbPsx" text="%console.psx" styleClass="console-toggle"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <TextField fx:id="txtSearch" promptText="%search.prompt"
                               styleClass="search-field" prefWidth="280.0" />
                    <Button fx:id="btnTheme" text="%button.theme.dark"
                            styleClass="subtle-button" onAction="#handleToggleTheme"/>
                    <Button fx:id="btnSettings" text="%button.settings"
                            styleClass="subtle-button" onAction="#handleOpenSettings"/>
                    <Button fx:id="btnDownloadList" text="%button.queue"
                            styleClass="queue-button" onAction="#handleOpenDownloadList"/>
                </HBox>

                <!-- Filter bar: filters, result count and the contextual add action -->
                <HBox styleClass="filter-bar" alignment="CENTER_LEFT" spacing="8.0">
                    <Label text="%label.region" styleClass="filter-label"/>
                    <ComboBox fx:id="comboRegion" styleClass="filter-combo" prefWidth="130.0"/>
                    <Label text="%label.filesize" styleClass="filter-label"/>
                    <ComboBox fx:id="comboSize" styleClass="filter-combo" prefWidth="130.0"/>

                    <Region HBox.hgrow="ALWAYS" />

                    <Label fx:id="resultCountLabel" text=" " styleClass="result-count"/>
                    <Button fx:id="btnRefresh" text="%button.refresh"
                            styleClass="subtle-button" onAction="#handleRefresh"/>
                </HBox>
            </VBox>
        </top>

        <center>
            <HBox styleClass="catalog-area" spacing="0.0">
                <TableView fx:id="tableGames" styleClass="game-table" HBox.hgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colTitle" text="%table.column.name" prefWidth="460.0"/>
                        <TableColumn fx:id="colRegion" text="%table.column.region" prefWidth="80.0"/>
                        <TableColumn fx:id="colSize" text="%table.column.size" prefWidth="110.0"/>
                        <TableColumn fx:id="colConsole" text="%table.column.console" prefWidth="90.0"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>
                    <placeholder>
                        <Label text="%table.empty"/>
                    </placeholder>
                </TableView>

                <VBox fx:id="detailPane" styleClass="game-detail" prefWidth="320.0" minWidth="300.0" spacing="8.0">
                    <Label fx:id="detailTitle" styleClass="detail-title" wrapText="true"/>
                    <Label fx:id="detailMeta" styleClass="detail-meta" wrapText="true"/>
                    <Label fx:id="detailStatus" styleClass="detail-badge" visible="false" managed="false"/>
                    <VBox spacing="3.0">
                        <Label text="%detail.contentid" styleClass="detail-label"/>
                        <Label fx:id="detailContentId" styleClass="detail-value" wrapText="true"/>
                    </VBox>
                    <Region VBox.vgrow="ALWAYS"/>
                    <Label fx:id="detailHint" text="%detail.none.hint" styleClass="detail-hint" wrapText="true"/>
                    <Button fx:id="btnDownloadNow" text="%button.downloadnow"
                            styleClass="primary-button" onAction="#handleDownloadNow"/>
                    <Button fx:id="btnAddToQueue" text="%button.addtoqueue"
                            styleClass="subtle-button" onAction="#handleAddToQueue"/>
                </VBox>
            </HBox>
        </center>

        <bottom>
            <VBox spacing="0.0">
                <VBox fx:id="progressContainer" styleClass="download-dock" spacing="6.0"/>
                <HBox styleClass="status-bar" alignment="CENTER_LEFT" spacing="8.0">
                    <Label fx:id="statusLabel" text="%status.ready" styleClass="status-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="btnToggleDock" text="%button.dock.hide"
                            styleClass="subtle-button" visible="false" managed="false"
                            onAction="#handleToggleDock"/>
                    <Button fx:id="btnResumePause" text="%button.pause"
                            styleClass="subtle-button" disable="true" onAction="#handleResumePause"/>
                    <Button fx:id="btnRetry" text="%button.retryfailed"
                            styleClass="subtle-button" disable="true" onAction="#handleRetryFailed"/>
                </HBox>
            </VBox>
        </bottom>
    </BorderPane>

    <VBox fx:id="queueDrawer" styleClass="queue-drawer"
          StackPane.alignment="TOP_RIGHT"
          prefWidth="420.0" minWidth="420.0" maxWidth="420.0"
          visible="false" managed="false">
        <StackPane.margin>
            <Insets top="56.0"/>
        </StackPane.margin>
    </VBox>

</StackPane>
