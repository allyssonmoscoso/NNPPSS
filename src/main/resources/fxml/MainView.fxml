<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane fx:id="rootStack"
           xmlns="http://javafx.com/javafx"
           xmlns:fx="http://javafx.com/fxml"
           fx:controller="com.squarepeace.nnppss.fx.controllers.MainController"
           prefHeight="700.0" prefWidth="1024.0">

    <BorderPane fx:id="mainContainer">
        <top>
            <VBox spacing="10.0" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="10.0" left="15.0" right="15.0" top="15.0" />
                </padding>

                <!-- Toolbar Row 1: Consoles & Actions -->
                <HBox alignment="CENTER_LEFT" spacing="15.0">
                    <Label text="%label.console">
                        <font><Font name="System Bold" size="12.0"/></font>
                    </Label>

                    <HBox fx:id="consoleBox" spacing="10.0" alignment="CENTER_LEFT">
                        <RadioButton fx:id="rbVita" text="%console.psvita" selected="true"/>
                        <RadioButton fx:id="rbPsp" text="%console.psp"/>
                        <RadioButton fx:id="rbPsx" text="%console.psx"/>
                    </HBox>

                    <Region HBox.hgrow="ALWAYS" />

                    <Button fx:id="btnAdd" text="%button.add" onAction="#handleAddSelected"/>
                    <Button fx:id="btnDownloadList" text="%button.downloadlist" onAction="#handleOpenDownloadList"/>
                </HBox>

                <!-- Toolbar Row 2: Filters & Search -->
                <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label text="%label.region" />
                    <ComboBox fx:id="comboRegion" prefWidth="120.0" />

                    <Label text="%label.filesize" />
                    <ComboBox fx:id="comboSize" prefWidth="120.0" />

                    <Region HBox.hgrow="ALWAYS" />

                    <Label text="%label.search" />
                    <TextField fx:id="txtSearch" promptText="%search.prompt" prefWidth="200.0" />

                    <Button fx:id="btnRefresh" text="%button.refresh" onAction="#handleRefresh" />
                    <Button fx:id="btnSettings" text="%button.settings" onAction="#handleOpenSettings" />
                </HBox>
            </VBox>
        </top>

        <center>
            <TableView fx:id="tableGames" BorderPane.alignment="CENTER">
                <columns>
                    <TableColumn fx:id="colTitle" text="%table.column.name" prefWidth="400.0" />
                    <TableColumn fx:id="colRegion" text="%table.column.region" prefWidth="80.0" />
                    <TableColumn fx:id="colId" text="%table.column.contentid" prefWidth="120.0" />
                    <TableColumn fx:id="colSize" text="%table.column.size" prefWidth="100.0" />
                    <TableColumn fx:id="colConsole" text="%table.column.console" prefWidth="80.0" />
                </columns>
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                </columnResizePolicy>
                <placeholder>
                    <Label text="%table.empty" />
                </placeholder>
            </TableView>
        </center>

        <bottom>
            <VBox spacing="5.0" BorderPane.alignment="CENTER">
                 <padding>
                    <Insets bottom="5.0" left="10.0" right="10.0" top="5.0" />
                 </padding>

                 <HBox alignment="CENTER_LEFT" spacing="10.0">
                    <Label fx:id="statusLabel" text="%status.ready" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="btnResumePause" text="%button.pause" disable="true" onAction="#handleResumePause" />
                    <Button fx:id="btnRetry" text="%button.retryfailed" disable="true" onAction="#handleRetryFailed" />
                 </HBox>

                 <VBox fx:id="progressContainer" spacing="5.0" maxHeight="250.0" />
            </VBox>
        </bottom>
    </BorderPane>

</StackPane>
